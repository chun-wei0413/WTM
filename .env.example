# Template for .env. Do not put real secrets in this file.
# Create the real .env (git-ignored) with fresh random secrets by running:
#   powershell -ExecutionPolicy Bypass -File scripts/init-env.ps1
# Both docker-compose and the Spring Boot app read it.

# Where the site keeps everything it stores: database files, collected pictures,
# backups. Subfolders postgres, images, inbox, logs and backups are created by scripts/init-env.ps1.
WTM_DATA_DIR=D:/wtm-data

DB_USERNAME=wtm
DB_PASSWORD=change-me

S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# At least 32 characters. Anyone who knows it can sign admin tokens.
WTM_JWT_SECRET=change-me

# The first administrator, created at startup when none exists yet.
WTM_ADMIN_USERNAME=admin
WTM_ADMIN_PASSWORD=change-me

# Which model looks at new pictures and describes them. One of:  mock | ollama | gemini
#   mock   = made-up descriptions, no model (the default when this line is left out)
#   ollama = the local model qwen2.5vl:7b (Ollama must be running; pictures stay on this machine)
#   gemini = Google Gemini (needs GEMINI_API_KEY below; pictures are sent to Google)
# WTM_EMBEDDING_PROVIDER and WTM_EXPLAINER_PROVIDER take  mock | ollama.
WTM_VISION_PROVIDER=mock

# Only for WTM_VISION_PROVIDER=gemini: a key from https://aistudio.google.com/apikey. Never commit a real one.
# On the free tier Google may use what is sent to improve its products, so use it for pictures that are already public.
GEMINI_API_KEY=
