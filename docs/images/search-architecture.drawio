<mxfile host="app.diagrams.net"><diagram name="search-architecture" id="wtm-search"><mxGraphModel defaultFontFamily="Microsoft JhengHei" dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sheet" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="-10" width="2000" height="1540" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="176" as="sourcePoint"/><mxPoint x="190" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1r" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="224" as="sourcePoint"/><mxPoint x="100" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="176" as="sourcePoint"/><mxPoint x="470" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2r" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="224" as="sourcePoint"/><mxPoint x="380" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="176" as="sourcePoint"/><mxPoint x="830" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3r" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="224" as="sourcePoint"/><mxPoint x="740" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="176" as="sourcePoint"/><mxPoint x="1190" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4r" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="224" as="sourcePoint"/><mxPoint x="1090" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e9" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="720" as="sourcePoint"/><mxPoint x="1090" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e10" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="720" as="sourcePoint"/><mxPoint x="700" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e11" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="660" as="sourcePoint"/><mxPoint x="870" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="1020" as="sourcePoint"/><mxPoint x="170" y="1135" as="targetPoint"/><Array as="points"><mxPoint x="100" y="1135"/></Array></mxGeometry></mxCell><mxCell id="b" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="1135" as="sourcePoint"/><mxPoint x="430" y="1020" as="targetPoint"/><Array as="points"><mxPoint x="430" y="1135"/></Array></mxGeometry></mxCell><mxCell id="c" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="955" as="sourcePoint"/><mxPoint x="580" y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="955" as="sourcePoint"/><mxPoint x="950" y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="g" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="929" as="sourcePoint"/><mxPoint x="1590" y="929" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="981" as="sourcePoint"/><mxPoint x="1520" y="981" as="targetPoint"/></mxGeometry></mxCell><mxCell id="title" value="WTM 檢索架構" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=28;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="700" height="40" as="geometry"/></mxCell><mxCell id="laneA" value="查詢流程(使用者搜尋時,實線)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=20;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="900" height="30" as="geometry"/></mxCell><mxCell id="user" value="使用者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=16;fontFamily=Microsoft JhengHei;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="50" height="100" as="geometry"/></mxCell><mxCell id="front" value="React 前端&lt;br&gt;搜尋頁 SearchPage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=16;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="190" y="140" width="190" height="120" as="geometry"/></mxCell><mxCell id="api" value="Spring Boot&lt;br&gt;SearchController" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="270" height="120" as="geometry"/></mxCell><mxCell id="handler" value="SearchTemplatesHandler&lt;br&gt;混合檢索流程總管" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="260" height="120" as="geometry"/></mxCell><mxCell id="embed" value="Ollama · bge-m3&lt;br&gt;嵌入模型&lt;br&gt;輸入:查詢文字&lt;br&gt;輸出:代表語意的向量" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1190" y="140" width="210" height="120" as="geometry"/></mxCell><mxCell id="pg" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=20;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1480" y="100" width="360" height="580" as="geometry"/></mxCell><mxCell id="pg_title" value="PostgreSQL" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1510" y="146" width="300" height="28" as="geometry"/></mxCell><mxCell id="vec" value="檢索索引:向量檢索&lt;br&gt;找語意最接近的梗圖&lt;br&gt;pgvector&lt;br&gt;只搜尋已核可的梗圖" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1510" y="180" width="300" height="110" as="geometry"/></mxCell><mxCell id="kw" value="檢索索引:關鍵字檢索&lt;br&gt;找字面最接近的梗圖&lt;br&gt;pg_trgm&lt;br&gt;只搜尋已核可的梗圖" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1510" y="360" width="300" height="110" as="geometry"/></mxCell><mxCell id="mem" value="梗圖資料&lt;br&gt;描述、標籤、圖中文字、狀態&lt;br&gt;(核可 / 下架)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1510" y="535" width="300" height="110" as="geometry"/></mxCell><mxCell id="cards" value="組裝結果&lt;br&gt;梗圖資料 + 圖片存取連結" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="830" y="660" width="260" height="120" as="geometry"/></mxCell><mxCell id="store1" value="圖片檔案庫&lt;br&gt;RustFS(S3 相容)&lt;br&gt;圖片存本機,不依賴原網站" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="470" y="660" width="230" height="120" as="geometry"/></mxCell><mxCell id="rrf" value="RRF 合併&lt;br&gt;(Reciprocal Rank Fusion)&lt;br&gt;兩份排名合成一份" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1190" y="660" width="220" height="120" as="geometry"/></mxCell><mxCell id="steps" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;strokeWidth=2;fontSize=16;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="760" height="320" as="geometry"/></mxCell><mxCell id="steps_t" value="步驟說明" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="70" y="305" width="700" height="24" as="geometry"/></mxCell><mxCell id="steps_b" value="1  使用者輸入想找的情境,或這張圖長什麼樣子&lt;br&gt;2  前端送出搜尋請求&lt;br&gt;3  控制器交給檢索流程總管 SearchTemplatesHandler&lt;br&gt;4  把查詢文字送給 bge-m3 嵌入模型(輸入:查詢文字)&lt;br&gt;5  模型輸出代表語意的向量,送回 Handler(嵌入服務掛了就略過這一路)&lt;br&gt;6  向量檢索:找出語意最接近的前幾名&lt;br&gt;7  關鍵字檢索:找出字面最接近的前幾名&lt;br&gt;8  兩份排名清單先合併成一條,再交給 RRF&lt;br&gt;9  RRF 合併兩份排名,取出最前面的幾名&lt;br&gt;10 依 id 向資料庫查梗圖資料(描述、標籤、圖中文字等)&lt;br&gt;11 依每張圖的位置,向圖片檔案庫取得有時效的存取連結&lt;br&gt;12 組裝好的結果交回 Handler&lt;br&gt;13 Handler 把結果清單交回控制器&lt;br&gt;14 控制器回傳 JSON&lt;br&gt;15 前端以卡片牆顯示,圖片依連結直接從圖片檔案庫載入" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;fontStyle=0;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="70" y="336" width="710" height="270" as="geometry"/></mxCell><mxCell id="laneB" value="建索引流程(背景作業,虛線)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=20;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c1" value="梗圖進圖庫&lt;br&gt;上傳 · 貼網址&lt;br&gt;收件匣 · 自動收集" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=16;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="190" height="130" as="geometry"/></mxCell><mxCell id="store2" value="圖片檔案庫&lt;br&gt;RustFS(S3 相容)&lt;br&gt;(與上方是同一個檔案庫)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="170" y="1080" width="230" height="110" as="geometry"/></mxCell><mxCell id="c2" value="TaggingWorker&lt;br&gt;排程:領取待標記的圖,&lt;br&gt;控制同時處理的張數" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="300" y="890" width="210" height="130" as="geometry"/></mxCell><mxCell id="cv" value="Ollama · qwen2.5vl:7b&lt;br&gt;視覺語言模型&lt;br&gt;輸入:梗圖圖片&lt;br&gt;輸出:是否為梗圖、名稱、意思、&lt;br&gt;使用情境、情緒、標籤、圖中文字" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="580" y="890" width="300" height="130" as="geometry"/></mxCell><mxCell id="c3" value="ApplyTagsHandler&lt;br&gt;依模型的判斷自動執行:&lt;br&gt;是梗圖 → 寫入並核可(上架)&lt;br&gt;不是 → 下架,不進搜尋" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="950" y="890" width="230" height="130" as="geometry"/></mxCell><mxCell id="c4" value="索引同步程式&lt;br&gt;定期比對「梗圖」和「搜尋索引」,&lt;br&gt;補缺的、更新過期的、移除不該有的" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1250" y="890" width="270" height="130" as="geometry"/></mxCell><mxCell id="c5" value="Ollama · bge-m3&lt;br&gt;嵌入模型&lt;br&gt;輸入:搜尋文字&lt;br&gt;輸出:代表語意的向量" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1590" y="890" width="200" height="130" as="geometry"/></mxCell><mxCell id="pg2" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=20;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="900" y="1080" width="660" height="170" as="geometry"/></mxCell><mxCell id="pg2_title" value="PostgreSQL" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=14;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1190" y="1089" width="100" height="22" as="geometry"/></mxCell><mxCell id="mem2" value="梗圖資料&lt;br&gt;描述、標籤、狀態" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="930" y="1135" width="270" height="80" as="geometry"/></mxCell><mxCell id="idx2" value="檢索索引&lt;br&gt;搜尋文字 + 向量" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1260" y="1135" width="270" height="80" as="geometry"/></mxCell><mxCell id="idx_steps_box" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;strokeWidth=2;fontSize=16;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="1275" width="960" height="235" as="geometry"/></mxCell><mxCell id="idx_steps_t" value="步驟說明" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="70" y="1295" width="300" height="24" as="geometry"/></mxCell><mxCell id="idx_steps" value="a  新梗圖進圖庫:圖片下載後存進圖片檔案庫(之後顯示圖片不再依賴原網站)&lt;br&gt;b  TaggingWorker 定期領取待標記的圖,從圖片檔案庫取出圖片&lt;br&gt;c  把圖片交給視覺語言模型 qwen2.5vl:7b(輸入:梗圖圖片)&lt;br&gt;d  模型輸出「是否為梗圖」等欄位,交給 ApplyTagsHandler&lt;br&gt;e  ApplyTagsHandler 照模型的判斷寫進資料庫:是梗圖就寫入描述並核可,不是就下架。全程自動,沒有人工審核&lt;br&gt;f  索引同步程式定期讀取「梗圖資料」,與「檢索索引」比對:缺的補上、過期的更新、不該有的移除&lt;br&gt;g  需要建立索引時,把名稱、別名、意思、情境、情緒、標籤、圖中文字串成一段搜尋文字,送給 bge-m3 嵌入模型(輸入:搜尋文字)&lt;br&gt;h  模型輸出代表語意的向量,送回索引同步程式&lt;br&gt;i  搜尋文字與向量寫入檢索索引,查詢流程搜的就是它(與上方是同一個資料庫)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;fontStyle=0;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="70" y="1325" width="910" height="175" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1290" y="20" width="22" height="22" as="geometry"/></mxCell><mxCell id="lgt0" value="本專案程式" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontFamily=Microsoft JhengHei;fontColor=#1a1a1a;fontStyle=0;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1326" y="21" width="100" height="22" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="22" height="22" as="geometry"/></mxCell><mxCell id="lgt1" value="Ollama 模型" style="