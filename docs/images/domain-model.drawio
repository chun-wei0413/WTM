 id="subtitle" value="Target design derived from the event storming: command → aggregate → domain event. Aggregates refer to each other by ID only. Colors match the board." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=15;fontFamily=Segoe UI;fontColor=#555555;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="2100" height="24" as="geometry"/></mxCell><mxCell id="f_account_t" value="Account — generic subdomain" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=18;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="120" width="360" height="28" as="geometry"/></mxCell><mxCell id="f_status_t" value="Today and target" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=18;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="535" width="360" height="28" as="geometry"/></mxCell><mxCell id="f_curation_t" value="Curation — core subdomain" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=18;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="544" y="120" width="940" height="28" as="geometry"/></mxCell><mxCell id="f_report_t" value="Feedback — supporting subdomain" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=18;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="544" y="870" width="940" height="28" as="geometry"/></mxCell><mxCell id="f_discovery_t" value="Discovery — core subdomain" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=18;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1584" y="120" width="560" height="28" as="geometry"/></mxCell><mxCell id="f_notes_t" valu