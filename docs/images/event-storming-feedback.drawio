&lt;br&gt;reopen the reports" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9a0e8;strokeColor=#8a5ab5;strokeWidth=1.5;shadow=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="948" y="1481" width="180" height="100" as="geometry"/></mxCell><mxCell id="c12_dat" value="templateId" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c5dc4c;strokeColor=#8da323;strokeWidth=1.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1136" y="1491" width="120" height="90" as="geometry"/></mxCell><mxCell id="c12_cmd" value="Reopen&lt;br&gt;Reports" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6bc5f5;strokeColor=#2f8fc4;strokeWidth=1.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1256" y="1491" width="130" height="90" as="geometry"/></mxCell><mxCell id="c12_act0" value="Administrator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2c616;strokeColor=#b8960a;strokeWidth=1.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1216" y="1567" width="96" height="56" as="geometry"/></mxCell><mxCell id="c12_ev0" value="Reports&lt;br&gt;Reopened" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fb9a45;strokeColor=#c46a1a;strokeWidth=1.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="1491" width="130" height="90" as="geometry"/></mxCell><mxCell id="c12_agg0" value="ReportCase" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf9a3;strokeColor=#cfc34a;strokeWidth=1.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1318" y="1423" width="150" height="76" as="geometry"/></mxCell><mxCell id="hot_t" value="Hot Spots: unclear, risky or promising places" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontFamily=Segoe UI;fon