.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="822" y="1090" width="130" height="90" as="geometry"/></mxCell><mxCell id="c5_agg0" value="Favorite" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf9a3;strokeColor=#cfc34a;strokeWidth=1.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="1022" width="150" height="76" as="geometry"/></mxCell><mxCell id="hot_t" value="Hot Spots: unclear, risky or promising places" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="1460" width="800" height="30" as="geometry"/></mxCell><mxCell id="hl1" value="1" style="ellipse;html=1;fillColor=#e53935;strokeColor=#b71c1c;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="46" y="1502" width="24" height="24" as="geometry"/></mxCell><mxCell id="hlt1" value="Searches are only logged outside the domain: the results and the click are not kept, so real use cannot show how accurate search is." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="82" y="1505" width="1960" height="22" as="geometry"/></mxCell><mxCell id="hl2" value="2" style="ellipse;html=1;fillColor=#e53935;strokeColor=#b71c1c;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="46" y="1538" width="24" height="24" as="geometry"/></mxCell><mxCell id="hlt2" value="A pick is not stored, so its cost and reproducibility cannot be checked, and nobody can tell afterwards why a meme was chosen." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="82" y="1541" width="1960" height="22" as="geometry"/></mxCell><mxCell id="title" value="WTM Event Storming: Discovery (core subdomain)" style="text;html=1;fontSize=30;fontStyle=1;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1900" height="42" as="geometry"/></mxCell><mxCell id="sub" value="How a published meme is found. The index is reconciled by state, not by events. Searching and picking only read, so they show read models and no event; only favorites change state here." style="text;html=1;fontSize=15;fontFamily=Segoe UI;fontColor=#555555;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1900" height="24" as="geometry"/></mxCell><mxCell id="lg_event" value="" style="rounded=0;html=1;fillColor=#fb9a45;strokeColor=#c46a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="30" height="24" as="geometry"/></mxCell><mxCell id="lgt_event" value="Domain Event" style="text;html=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="78" y="94" width="170" height="20" as="geometry"/></mxCell><mxCell id="lg_command" value="" style="rounded=0;html=1;fillColor=#6bc5f5;strokeColor=#2f8fc4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="255" y="92" width="30" height="24" as="geometry"/></mxCell><mxCell id="lgt_command" value="Command" style="text;html=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="293" y="94" width="170" height="20" as="geometry"/></mxCell><mxCell id="lg_aggregate" value="" style="rounded=0;html=1;fillColor=#fdf9a3;strokeColor=#cfc34a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="92" width="30" height="24" as="geometry"/></mxCell><mxCell id="lgt_aggregate" value="Aggregate" style="text;html=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="508" y="94" width="170