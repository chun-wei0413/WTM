Geometry x="504" y="1800" width="120" height="90" as="geometry"/></mxCell><mxCell id="c11_cmd" value="Restore&lt;br&gt;Profile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6bc5f5;strokeColor=#2f8fc4;strokeWidth=1.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="624" y="1800" width="130" height="90" as="geometry"/></mxCell><mxCell id="c11_act0" value="Administrator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2c616;strokeColor=#b8960a;strokeWidth=1.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="584" y="1876" width="96" height="56" as="geometry"/></mxCell><mxCell id="c11_ev0" value="Profile&lt;br&gt;Restored" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fb9a45;strokeColor=#c46a1a;strokeWidth=1.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="768" y="1800" width="130" height="90" as="geometry"/></mxCell><mxCell id="c11_agg0" value="MemeTemplate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf9a3;strokeColor=#cfc34a;strokeWidth=1.5;shadow=1;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="686" y="1732" width="150" height="76" as="geometry"/></mxCell><mxCell id="hot_t" value="Hot Spots: unclear, risky or promising places" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="2000" width="800" height="30" as="geometry"/></mxCell><mxCell id="hl1" value="1" style="ellipse;html=1;fillColor=#e53935;strokeColor=#b71c1c;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="46" y="2042" width="24" height="24" as="geometry"/></mxCell><mxCell id="hlt1" value="A rejected or duplicate picture leaves no event, so we cannot say how many pictures were turned away, or why." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="82" y="2045" width="1960" height="22" as="geometry"/></mxCell><mxCell id="hl2" value="2" style="ellipse;html=1;fillColor=#e53935;strokeColor=#b71c1c;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="46" y="2078" width="24" height="24" as="geometry"/></mxCell><mxCell id="hlt2" value="A template can be retired by a person or by the model, but the event does not say which. Profile changes record a source; retiring does not." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="82" y="2081" width="1960" height="22" as="geometry"/></mxCell><mxCell id="hl3" value="3" style="ellipse;html=1;fillColor=#e53935;strokeColor=#b71c1c;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="46" y="2114" width="24" height="24" as="geometry"/></mxCell><mxCell id="hlt3" value="Whatever the model describes is approved with no person looking. That is a business decision, and today it lives only inside a handler." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="82" y="2117" width="1960" height="22" as="geometry"/></mxCell><mxCell id="hl4" value="4" style="ellipse;html=1;fillColor=#e53935;strokeColor=#b71c1c;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="46" y="2150" width="24" height="24" as="geometry"/></mxCell><mxCell id="hlt4" value="Pictures wait for the model in a queue that lives outside the domain. If the model keeps failing on a picture, nothing in the domain says so, and nobody is told." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="82" y="2153" width="1960" height="22" as="geometry"/></mxCell><mxCell id="title" value="WTM Event Storming: Curation (core subdomain)" style="text;html=1;fontSize=30;fontStyle=1;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1900" height="42" as="geometry"/></mxCell><mxCell id="sub" value="How a picture becomes a published meme. Only business facts are events; the queue of pictures waiting for the model is not on the board. Events are analysis facts; the code stores state." style="text;html=1;fontSize=15;fontFamily=Segoe UI;fontColor=#555555;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1900" height="24" as="geometry"/></mxCell><mxCell id="lg_event" value="" style="rounded=0;html=1;fillColor=#fb9a45;strokeColor=#c46a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="30" height="24" as="geometry"/></mxCell><mxCell id="lgt_event" value="Domain Event" style="text;html=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="78" y="94" width="170" height="20" as="geometry"/></mxCell><mxCell id="lg_command" value="" style="rounded=0;html=1;fillColor=#6bc5f5;strokeColor=#2f8fc4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="255" y="92" width="30" height="24" as="geometry"/></mxCell><mxCell id="lgt_command" value="Command" style="text;html=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="293" y="94" width="170" height="20" as="geometry"/></mxCell><mxCell id="lg_aggregate" value="" style="rounded=0;html=1;fillColor=#fdf9a3;strokeColor=#cfc34a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="92" width="30" height="24" as="geometry"/></mxCell><mxCell id="lgt_aggregate" value="Aggregate" style="text;html=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="508" y="94" width="170" height="20" as="geometry"/></mxCell><mxCell id="lg_data" value="" style="rounded=0;html=1;fillColor=#c5dc4c;strokeColor=#8da323;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="685" y="92" width="30" height="24" as="geometry"/></mxCell><mxCell id="lgt_data" value="Read model / data" style="text;html=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="723" y="94" width="170" height="20" as="geometry"/></mxCell><mxCell id="lg_policy" value="" style="rounded=0;html=1;fillColor=#c9a0e8;strokeColor=#8a5ab5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="92" width="30" height="24" as="geometry"/></mxCell><mxCell id="lgt_policy" value="Policy" style="text;html=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="938" y="94" width="170" height="20" as="geometry"/></mxCell><mxCell id="lg_external" value="" style="rounded=0;html=1;fillColor=#f9a8c4;strokeColor=#c0607f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1115" y="92" width="30" height="24" as="geometry"/></mxCell><mxCell id="lgt_external" value="External system" style="text;html=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1153" y="94" width="170" height="20" as="geometry"/></mxCell><mxCell id="lg_actor" value="" style="rounded=0;html=1;fillColor=#f2c616;strokeColor=#b8960a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1330" y="92" width="30" height="24" as="geometry"/></mxCell><mxCell id="lgt_actor" value="Person" style="text;html=1;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1368" y="94" width="170" height="20" as="geometry"/></mxCell><mxCell id="lg_timer" value="" style="rounded=0;html=1;fillColor=#e3e3e3;strokeColor=