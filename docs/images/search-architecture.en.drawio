<mxfile host="app.diagrams.net"><diagram name="search-architecture-en" id="wtm-search-en"><mxGraphModel defaultFontFamily="Segoe UI" dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sheet" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="-10" width="2000" height="1540" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="176" as="sourcePoint"/><mxPoint x="190" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1r" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="224" as="sourcePoint"/><mxPoint x="100" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="176" as="sourcePoint"/><mxPoint x="470" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2r" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="224" as="sourcePoint"/><mxPoint x="380" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="176" as="sourcePoint"/><mxPoint x="830" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3r" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="224" as="sourcePoint"/><mxPoint x="740" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="176" as="sourcePoint"/><mxPoint x="1190" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4r" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="224" as="sourcePoint"/><mxPoint x="1090" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e9" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="720" as="sourcePoint"/><mxPoint x="1090" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e10" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="720" as="sourcePoint"/><mxPoint x="700" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e11" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="660" as="sourcePoint"/><mxPoint x="870" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="1020" as="sourcePoint"/><mxPoint x="170" y="1135" as="targetPoint"/><Array as="points"><mxPoint x="100" y="1135"/></Array></mxGeometry></mxCell><mxCell id="b" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="1135" as="sourcePoint"/><mxPoint x="430" y="1020" as="targetPoint"/><Array as="points"><mxPoint x="430" y="1135"/></Array></mxGeometry></mxCell><mxCell id="c" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="955" as="sourcePoint"/><mxPoint x="580" y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="955" as="sourcePoint"/><mxPoint x="950" y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="g" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="929" as="sourcePoint"/><mxPoint x="1590" y="929" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="981" as="sourcePoint"/><mxPoint x="1520" y="981" as="targetPoint"/></mxGeometry></mxCell><mxCell id="title" value="WTM Search Architecture" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=28;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="700" height="40" as="geometry"/></mxCell><mxCell id="laneA" value="Query flow (when someone searches, solid lines)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=20;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="900" height="30" as="geometry"/></mxCell><mxCell id="user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=16;fontFamily=Segoe UI;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="50" height="100" as="geometry"/></mxCell><mxCell id="front" value="React front end&lt;br&gt;SearchPage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=16;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="190" y="140" width="190" height="120" as="geometry"/></mxCell><mxCell id="api" value="Spring Boot&lt;br&gt;SearchController" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="270" height="120" as="geometry"/></mxCell><mxCell id="handler" value="SearchTemplatesHandler&lt;br&gt;Hybrid search coordinator" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="260" height="120" as="geometry"/></mxCell><mxCell id="embed" value="Ollama · bge-m3&lt;br&gt;Embedding model&lt;br&gt;Input: query text&lt;br&gt;Output: meaning vector" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1190" y="140" width="210" height="120" as="geometry"/></mxCell><mxCell id="pg" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=20;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1480" y="100" width="360" height="580" as="geometry"/></mxCell><mxCell id="pg_title" value="PostgreSQL" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1510" y="146" width="300" height="28" as="geometry"/></mxCell><mxCell id="vec" value="Search index: vector search&lt;br&gt;Finds the closest memes by meaning&lt;br&gt;pgvector&lt;br&gt;Only approved memes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1510" y="180" width="300" height="110" as="geometry"/></mxCell><mxCell id="kw" value="Search index: keyword search&lt;br&gt;Finds the closest memes by wording&lt;br&gt;pg_trgm&lt;br&gt;Only approved memes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1510" y="360" width="300" height="110" as="geometry"/></mxCell><mxCell id="mem" value="Meme data&lt;br&gt;Description, tags, text in the image, status&lt;br&gt;(approved / withdrawn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1510" y="535" width="300" height="110" as="geometry"/></mxCell><mxCell id="cards" value="Result assembly&lt;br&gt;Meme data + image access links" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="830" y="660" width="260" height="120" as="geometry"/></mxCell><mxCell id="store1" value="Image storage&lt;br&gt;RustFS (S3-compatible)&lt;br&gt;Images are kept locally,&lt;br&gt;not loaded from the source site" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="470" y="660" width="230" height="120" as="geometry"/></mxCell><mxCell id="rrf" value="RRF merge&lt;br&gt;(Reciprocal Rank Fusion)&lt;br&gt;Merges two rankings into one" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1190" y="660" width="220" height="120" as="geometry"/></mxCell><mxCell id="steps" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;strokeWidth=2;fontSize=16;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="760" height="320" as="geometry"/></mxCell><mxCell id="steps_t" value="Steps" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="70" y="305" width="700" height="24" as="geometry"/></mxCell><mxCell id="steps_b" value="1  The user describes the situation, or what the meme looks like&lt;br&gt;2  The front end sends the search request&lt;br&gt;3  The controller hands it to SearchTemplatesHandler&lt;br&gt;4  The query text goes to the bge-m3 embedding model&lt;br&gt;5  The model returns a vector of its meaning (if the service is down, this route is skipped)&lt;br&gt;6  Vector search: the top matches by meaning&lt;br&gt;7  Keyword search: the top matches by wording&lt;br&gt;8  Both ranked lists go to RRF (the two lines merge into one)&lt;br&gt;9  RRF merges the two rankings and keeps the best few&lt;br&gt;10 Look up the meme data by id (description, tags, text in the image)&lt;br&gt;11 Get a time-limited access link for each image from the image storage&lt;br&gt;12 The assembled result goes back to the handler&lt;br&gt;13 The handler returns the list to the controller&lt;br&gt;14 The controller replies with JSON&lt;br&gt;15 The front end shows a wall of cards; images load straight from the image storage" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=0;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="70" y="336" width="710" height="270" as="geometry"/></mxCell><mxCell id="laneB" value="Indexing flow (background work, dashed lines)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=20;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c1" value="A meme is added&lt;br&gt;upload · URL&lt;br&gt;inbox · collector" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=16;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="190" height="130" as="geometry"/></mxCell><mxCell id="store2" value="Image storage&lt;br&gt;RustFS (S3-compatible)&lt;br&gt;(same storage as above)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="170" y="1080" width="230" height="110" as="geometry"/></mxCell><mxCell id="c2" value="TaggingWorker&lt;br&gt;Scheduler: picks up images&lt;br&gt;waiting to be tagged,&lt;br&gt;limits how many run at once" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="300" y="890" width="210" height="130" as="geometry"/></mxCell><mxCell id="cv" value="Ollama · qwen2.5vl:7b&lt;br&gt;Vision-language model&lt;br&gt;Input: the meme image&lt;br&gt;Output: is it a meme, name, meaning,&lt;br&gt;usage, emotions, tags, text in the image" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="580" y="890" width="300" height="130" as="geometry"/></mxCell><mxCell id="c3" value="ApplyTagsHandler&lt;br&gt;Acts on the model’s verdict:&lt;br&gt;meme → save, approve&lt;br&gt;not a meme → withdraw" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="950" y="890" width="230" height="130" as="geometry"/></mxCell><mxCell id="c4" value="Index sync job&lt;br&gt;Regularly compares memes&lt;br&gt;with the search index:&lt;br&gt;adds missing, refreshes stale,&lt;br&gt;removes what does not belong" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1250" y="890" width="270" height="130" as="geometry"/></mxCell><mxCell id="c5" value="Ollama · bge-m3&lt;br&gt;Embedding model&lt;br&gt;Input: search text&lt;br&gt;Output: meaning vector" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1590" y="890" width="200" height="130" as="geometry"/></mxCell><mxCell id="pg2" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=20;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="900" y="1080" width="660" height="170" as="geometry"/></mxCell><mxCell id="pg2_title" value="PostgreSQL" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1190" y="1089" width="100" height="22" as="geometry"/></mxCell><mxCell id="mem2" value="Meme data&lt;br&gt;Description, tags, status" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="930" y="1135" width="270" height="80" as="geometry"/></mxCell><mxCell id="idx2" value="Search index&lt;br&gt;Search text + vector" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1260" y="1135" width="270" height="80" as="geometry"/></mxCell><mxCell id="idx_steps_box" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;strokeWidth=2;fontSize=16;fontFamily=Segoe UI;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="1275" width="1900" height="215" as="geometry"/></mxCell><mxCell id="idx_steps_t" value="Steps" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=1;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="70" y="1295" width="300" height="24" as="geometry"/></mxCell><mxCell id="idx_steps" value="a  A new meme is added: its image is downloaded into the image storage (showing it no longer depends on the original site)&lt;br&gt;b  TaggingWorker regularly picks up images waiting to be tagged and reads them from the image storage&lt;br&gt;c  The image goes to the vision-language model qwen2.5vl:7b (input: the meme image)&lt;br&gt;d  The model outputs fields such as “is it a meme” and hands them to ApplyTagsHandler&lt;br&gt;e  ApplyTagsHandler saves the result to the database as the model judged: a meme gets its description saved and is approved, anything else is withdrawn. All automatic, no human review&lt;br&gt;f  The index sync job regularly reads the meme data and compares it with the search index: missing entries are added, stale ones refreshed, entries that do not belong removed&lt;br&gt;g  When an entry needs indexing, its name, aliases, meaning, situations, emotions, tags and text in the image are joined into one search text and sent to the bge-m3 embedding model&lt;br&gt;h  The model returns a vector of its meaning to the index sync job&lt;br&gt;i  The search text and vector are written to the search index, which is what the query flow searches (same database as above)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=0;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="70" y="1325" width="1840" height="150" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1230" y="20" width="22" height="22" as="geometry"/></mxCell><mxCell id="lgt0" value="WTM application" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=0;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1266" y="21" width="120" height="22" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1390" y="20" width="22" height="22" as="geometry"/></mxCell><mxCell id="lgt1" value="Ollama model" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=0;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1426" y="21" width="120" height="22" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1550" y="20" width="22" height="22" as="geometry"/></mxCell><mxCell id="lgt2" value="PostgreSQL" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=0;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1586" y="21" width="120" height="22" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1710" y="20" width="22" height="22" as="geometry"/></mxCell><mxCell id="lgt3" value="Image storage" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=0;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1746" y="21" width="120" height="22" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1870" y="20" width="22" height="22" as="geometry"/></mxCell><mxCell id="lgt4" value="Algorithm" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontFamily=Segoe UI;fontColor=#1a1a1a;fontStyle=0;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1906" y="21" width="120" height="22" as="geometry"/></mxCell><mxCell id="e6" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="140" as="sourcePoint"/><mxPoint x="1510" y="235" as="targetPoint"/><Array as="points"><mxPoint x="960" y="80"/><mxPoint x="1450" y="80"/><mxPoint x="1450" y="235"/></Array></mxGeometry></mxCell><mxCell id="e7" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1