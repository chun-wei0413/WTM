# Build output (also holds the evaluation reports and generated memes)
target/

# IDE and OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Logs and crash dumps
*.log
hs_err_pid*

# --- Secrets and local configuration ---------------------------------------
# Environment files (keep .env.example as the committed template)
.env
.env.*
!.env.example

# Spring Boot reads ./config/application.yml on top of the bundled one, so put
# real passwords and keys there, or in a local profile file
/config/
application-local.yml
application-local.yaml
application-local.properties
application-*-local.yml

# Keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/

# Kubernetes: cluster credentials, and any Secret manifest written out with real values
kubeconfig*
*.kubeconfig
k8s/*secret*.yaml
k8s/*secret*.yml

# Claude Code's local folder: personal settings and skills. Some of the skills (docx, pdf, pptx) are under
# Anthropic's own license, which does not allow copies to be redistributed, so none of it is committed.
.claude/

# The site's own data (database files, collected pictures, backups) must never be committed
wtm-data/
/data/
/inbox/
*.dump
*.sql.gz
*.bak

# Results of the library search evaluation; baseline.json is the committed reference
eval/results/*
!eval/results/baseline.json
